      "bundleIdentifier": "org.alihsan.mobile",
      "config": {
        "googleMapsApiKey": "AIzaSyAr-lr0NLXtT58Q53qE53uvLQU5u8wHa9Y"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#264B8B"
      },
      "package": "org.alihsan.mobile",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAr-lr0NLXtT58Q53qE53uvLQU5u8wHa9Y"
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "scheme": "alihsan",
    "plugins": ["expo-router"]
  }
}
